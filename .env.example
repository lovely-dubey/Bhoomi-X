# ─── BHOOMI-X Environment Variables Template ───
# Copy this to .env and backend/.env and update your values

# Database
POSTGRES_DB=bhoomix
POSTGRES_USER=bhoomix
POSTGRES_PASSWORD=your_password_here

# Backend
DATABASE_URL=postgresql+asyncpg://bhoomix:your_password_here@localhost:5432/bhoomix
DATABASE_URL_SYNC=postgresql://bhoomix:your_password_here@localhost:5432/bhoomix
ENVIRONMENT=development

# Matching Pipeline Weights
SPATIAL_WEIGHT=0.50
ATTRIBUTE_WEIGHT=0.30
SOURCE_AGREEMENT_WEIGHT=0.20

# Confidence Thresholds
CONFIDENCE_AUTO_APPROVE=90
CONFIDENCE_REVIEW=70
CONFIDENCE_ESCALATE=50

# Area Mismatch Threshold (fraction)
AREA_MISMATCH_THRESHOLD=0.05

# Boundary Mismatch Threshold (meters)
BOUNDARY_MISMATCH_THRESHOLD=2.0

# Project CRS
PROJECT_CRS=EPSG:4326
LOCAL_UTM_CRS=EPSG:32643
